import { SelectableText } from "../selectable-text.slint";
import { ActionButton as Button, ChoiceBox as ComboBox, ToggleCheck as CheckBox } from "../theme.slint";
import { LineEdit, ScrollView, Palette } from "std-widgets.slint";

component FieldLabel inherits Rectangle {
    in property <string> label;
    in property <string> help;
    in property <string> help-label: label;
    height: 24px;
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        SelectableText { text: root.label; text-color: #253b52; font-size: 13px; vertical-alignment: center; }
        Rectangle {
            width: 18px; height: 18px;
            border-radius: 9px; border-width: 1px; border-color: #b4cad8;
            background: #e8f2f7;
            accessible-role: button;
            accessible-label: @tr("Help: ") + root.help-label + ". " + root.help;
            accessible-action-default => { help-popup.show(); }
            Text { text: "i"; color: #176b83; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { mouse-cursor: pointer; clicked => { help-popup.show(); } }
            Tooltip {
                VerticalLayout {
                    padding: 12px;
                    Text { width: 320px; text: root.help; color: Palette.foreground; wrap: word-wrap; font-size: 13px; }
                }
            }
            help-popup := PopupWindow {
                width: 370px;
                Rectangle {
                    background: #ffffff;
                    VerticalLayout { padding: 16px; spacing: 12px;
                        SelectableText { text: root.help-label; text-color: #192b42; font-weight: 700; wrap: word-wrap; }
                        SelectableText { text: root.help; text-color: #596f85; wrap: word-wrap; }
                        Button { text: @tr("Close help"); clicked => { help-popup.close(); } }
                    }
                }
            }
        }
    }
}

component StepTab inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback selected;
    height: 46px;
    border-radius: 8px;
    background: active ? #e1f1f5 : #f4f7fb;
    border-width: 1px; border-color: active ? #176b83 : #dce4ed;
    Text { text: root.label; color: root.active ? #145a70 : #62748a; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    forward-focus: focus;
    focus := FocusScope { key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.selected(); return accept; } return reject; } }
    TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.selected(); } }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.selected(); }
}

component Hint inherits Rectangle {
    in property <string> text;
    background: #edf5f9; border-radius: 8px;
    VerticalLayout { padding: 14px;
        SelectableText { text: root.text; text-color: #526e83; wrap: word-wrap; font-size: 12px; }
    }
}

export component ServerForm inherits Rectangle {
    in-out property <string> server-name;
    in-out property <string> host;
    in-out property <string> port: "22";
    in-out property <string> username;
    in-out property <int> authentication: 0;
    in-out property <string> key-path;
    in-out property <string> secret;
    in-out property <bool> remember;
    in-out property <int> docker-access: 0;
    in-out property <string> timeout: "10";
    in property <string> result;
    in property <bool> busy;
    in property <bool> tested;
    in property <string> ssh-key-compatibility;
    private property <int> step: 0;
    callback edited;
    callback browse;
    callback test;
    callback save;
    callback cancel;
    background: #ffffff;
    border-radius: 14px;
    border-width: 1px; border-color: #dce4ed;

    VerticalLayout {
        padding: 28px; spacing: 18px;
        HorizontalLayout {
            VerticalLayout { spacing: 5px;
                SelectableText { text: @tr("Connect a Docker server"); font-size: 24px; font-weight: 700; text-color: #192b42; }
                SelectableText { text: @tr("Give it a name. Choose how to sign in. Test, then save."); text-color: #62748a; font-size: 13px; }
            }
            Rectangle { horizontal-stretch: 1; }
            SelectableText { text: "SSH"; text-color: #176b83; font-size: 12px; font-weight: 700; vertical-alignment: center; }
        }
        HorizontalLayout { spacing: 10px;
            StepTab { label: @tr("1   Connection"); active: root.step == 0; selected => { root.step = 0; } }
            StepTab { label: @tr("2   Sign-in"); active: root.step == 1; selected => { root.step = 1; } }
            StepTab { label: @tr("3   Docker & test"); active: root.step == 2; selected => { root.step = 2; } }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding-right: 8px; spacing: 16px;
                if root.step == 0 : VerticalLayout {
                    spacing: 18px;
                    SelectableText { text: @tr("Where is your server?"); text-color: #192b42; font-size: 18px; font-weight: 600; }
                    VerticalLayout { spacing: 7px;
                        FieldLabel { label: @tr("Server name"); help: @tr("A friendly name shown only in ContainerSafe, such as Home NAS or Production Docker. It does not rename the remote computer."); }
                        name := LineEdit { text <=> root.server-name; placeholder-text: @tr("e.g. Home NAS"); min-height: 40px; edited => { root.edited(); } }
                    }
                    VerticalLayout { spacing: 7px;
                        FieldLabel { label: @tr("Hostname or IP address"); help: @tr("The address of the computer running Docker, for example nas.local or 192.168.1.20. Enter only the hostname or IP, without https://, an SSH username, port or folder path."); }
                        LineEdit { text <=> root.host; placeholder-text: @tr("e.g. nas.local or 192.168.1.20"); min-height: 40px; edited => { root.edited(); } }
                    }
                    HorizontalLayout { spacing: 20px;
                        VerticalLayout { spacing: 7px;
                            FieldLabel { label: @tr("SSH port"); help: @tr("The port used by the server's SSH service. Usually 22. Change it only if your SSH service or port forwarding uses another port. Valid range: 1-65535."); }
                            LineEdit { text <=> root.port; min-height: 40px; edited => { root.edited(); } }
                        }
                        Hint { text: @tr("Use the same address and port you would use in PuTTY or an SSH terminal."); }
                    }
                    Hint { text: @tr("SSH must already be enabled on this server. ContainerSafe will ask you to review its identity before signing in for the first time."); }
                }
                if root.step == 1 : VerticalLayout {
                    spacing: 16px;
                    VerticalLayout { spacing: 7px;
                        FieldLabel { label: @tr("SSH username"); help: @tr("An existing login account on the remote server, such as your NAS user. This is not your Docker Hub account. The account must be allowed to use SSH and access Docker."); }
                        LineEdit { text <=> root.username; placeholder-text: @tr("Your remote server account"); min-height: 40px; edited => { root.edited(); } }
                    }
                    VerticalLayout { spacing: 7px;
                        FieldLabel { label: @tr("How do you sign in?"); help: @tr("Password: use your remote account password. OpenSSH key: use a private key file stored on this computer; its public key must be installed on the server. PuTTY (.ppk): follow the export guide to convert your key to supported OpenSSH format first."); }
                        ComboBox {
                            model: [@tr("Account password"), @tr("PuTTY key (.ppk) - export guide"), @tr("OpenSSH private key")];
                            current-index <=> root.authentication;
                            selected(value) => { root.secret = ""; root.edited(); }
                        }
                    }
                    if root.authentication == 0 : Hint { text: @tr("Password login uses the password of your SSH account on the remote server."); }
                    if root.authentication == 2 : VerticalLayout {
                        spacing: 7px;
                        Hint { text: root.ssh-key-compatibility; }
                        FieldLabel { label: @tr("Private key file"); help: @tr("Choose your private OpenSSH key on this computer, not its .pub public-key file. The matching public key must be in the remote user's authorized_keys. Your private key file is not uploaded to the server."); }
                        HorizontalLayout { spacing: 10px;
                            LineEdit { text <=> root.key-path; placeholder-text: @tr("Choose a private key on this computer"); min-height: 40px; edited => { root.edited(); } }
                            Button { text: @tr("Browse..."); clicked => { root.browse(); } Tooltip { text: @markdown("\{@tr("Choose your existing private key file. No file is uploaded.")}"); } }
                        }
                    }
                    if root.authentication == 1 : VerticalLayout {
                        spacing: 14px;
                        Hint { text: @tr("Already using PuTTY? Export your key once\n\n1. Open the .ppk file in PuTTYgen.\n2. Keep a passphrase and choose Conversions > Export OpenSSH key.\n3. Save the exported private key on this computer.\n4. Choose OpenSSH below and browse to that exported file.\n\nPPK files cannot be used directly. Your original key is unchanged.\n\n") + root.ssh-key-compatibility; }
                        Button { text: @tr("Use my exported OpenSSH key"); clicked => { root.authentication = 2; root.secret = ""; root.edited(); } }
                    }
                    if root.authentication != 1 : VerticalLayout {
                        spacing: 7px;
                        FieldLabel {
                            label: root.authentication == 0 ? @tr("Account password") : @tr("Key passphrase (optional)");
                            help: root.authentication == 0 ? @tr("The password for the SSH username above. It is sent only through the encrypted SSH connection after you approve the server identity. It is not your Windows password unless both accounts happen to use the same password.") : @tr("The password that unlocks this private key file, which can differ from your server account password. Leave blank only if the key is not encrypted.");
                        }
                        LineEdit { text <=> root.secret; input-type: password; min-height: 40px; edited => { root.edited(); } }
                        HorizontalLayout { spacing: 10px; alignment: start;
                            CheckBox { horizontal-stretch: 0; text: @tr("Remember on this computer"); checked <=> root.remember; toggled => { root.edited(); } }
                            FieldLabel { width: 26px; help-label: @tr("Remember on this computer"); label: ""; help: @tr("Enabled: store the password or key passphrase in the operating-system credential store. Disabled: keep it only for this app session; you must enter it again next time. The profile itself never contains the password. A private key file stays where you selected it."); }
                        }
                    }
                }
                if root.step == 2 : VerticalLayout {
                    spacing: 16px;
                    SelectableText { text: @tr("Check access before saving"); text-color: #192b42; font-size: 18px; font-weight: 600; }
                    VerticalLayout { spacing: 7px;
                        FieldLabel { label: @tr("Docker access"); help: @tr("Automatic: try Docker directly, then passwordless sudo if needed. Direct Docker CLI: run Docker as the SSH user, usually with Docker group permissions. Passwordless sudo -n: run Docker through sudo without prompting; the server must already allow this. Your SSH password is never used as a sudo password."); }
                        ComboBox { model: [@tr("Automatic (recommended)"), @tr("Direct Docker CLI"), @tr("Passwordless sudo -n")]; current-index <=> root.docker-access; selected(value) => { root.edited(); } }
                        Hint { text: root.docker-access == 0 ? @tr("Automatic tries direct access first, then passwordless sudo. A good starting point if you are unsure.") : root.docker-access == 1 ? @tr("Use the SSH user's existing Docker permissions. No sudo is attempted.") : @tr("Use existing passwordless sudo permissions. ContainerSafe cannot answer a sudo password prompt or grant permissions."); }
                    }
                    VerticalLayout { spacing: 7px;
                        FieldLabel { label: @tr("Connection timeout (seconds)"); help: @tr("How long SSH network operations may wait before reporting a timeout. Default: 10 seconds. Increase for a slow or distant server. Valid range: 1-120 seconds. This does not schedule backups."); }
                        LineEdit { text <=> root.timeout; min-height: 40px; edited => { root.edited(); } }
                    }
                    Rectangle {
                        background: root.tested ? #e8f5ed : #f0f5fa; border-radius: 8px;
                        VerticalLayout { padding: 16px; spacing: 8px;
                            FieldLabel { label: root.tested ? @tr("Connection verified") : @tr("Connection check"); help: @tr("Test checks SSH connectivity, server identity, authentication and Docker access, then reads the container inventory. Save becomes available only after a successful test. Changing a field requires a new test. This does not run a backup."); }
                            report := SelectableText { text: root.result; wrap: word-wrap; text-color: root.tested ? #286b4c : #526e83; font-size: 12px; }
                            Button { text: @tr("Copy report"); clicked => { report.copy-all(); } }
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
        Rectangle { height: 1px; background: #dce4ed; }
        SelectableText { text: root.busy ? @tr("Checking your server...") : root.tested ? @tr("Verified. You can now save this server.") : @tr("Save unlocks after a successful connection test."); text-color: root.tested ? #286b4c : #62748a; font-size: 12px; }
        HorizontalLayout { spacing: 10px;
            Button { text: @tr("Cancel"); clicked => { root.cancel(); } }
            if root.step > 0 : Button { text: @tr("Back"); clicked => { root.step -= 1; } }
            Rectangle { horizontal-stretch: 1; }
            if root.step < 2 : Button { text: @tr("Continue"); clicked => { root.step += 1; } }
            if root.step == 2 : Button { text: root.busy ? @tr("Testing...") : @tr("Test connection"); enabled: !root.busy && root.authentication != 1; clicked => { root.test(); } }
            Button { text: @tr("Save server"); enabled: root.tested && !root.busy; clicked => { root.save(); } Tooltip { text: @markdown("\{@tr("Save this profile after a successful connection test. Changes require testing again.")}"); } }
        }
    }
    public function focus-first() { root.step = 0; }
}
