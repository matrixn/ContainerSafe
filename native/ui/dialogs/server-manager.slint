import { SelectableText } from "../selectable-text.slint";
import { ActionButton as Button } from "../theme.slint";
import { ListView } from "std-widgets.slint";
component CopyHostButton inherits Rectangle {
    in property <bool> copied;
    callback clicked;
    width: 28px; height: 28px; border-radius: 5px;
    background: root.copied ? #e3f3eb : touch.pressed ? #dbe8ee : touch.has-hover ? #e7f0f5 : transparent;
    border-width: focus.has-focus ? 1px : 0px; border-color: #176b83;
    accessible-role: button; accessible-label: root.copied ? @tr("Copied") : @tr("Copy host");
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    focus := FocusScope { key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.clicked(); return accept; } return reject; } }
    Image { x: 6px; y: 6px; width: 16px; height: 16px;
        source: root.copied ? @image-url("../../assets/icons/check.svg") : @image-url("../../assets/icons/clipboard.svg");
        colorize: root.copied ? #25825e : #58778d; image-fit: contain;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
    Tooltip { Text { text: root.copied ? @tr("Copied") : @tr("Copy host"); } }
    animate background { duration: 100ms; }
}
component RowIconButton inherits Rectangle {
    in property <image> icon;
    in property <color> tint;
    in property <string> label;
    callback clicked;
    width: 28px; height: 28px; border-radius: 6px;
    background: touch.pressed ? #dae7ef : touch.has-hover ? #eaf2f8 : transparent;
    border-width: focus.has-focus ? 1px : 0px; border-color: #4a8da6;
    accessible-role: button; accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    focus := FocusScope { key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.clicked(); return accept; } return reject; } }
    Image { x: 5px; y: 5px; width: 18px; height: 18px; source: root.icon; colorize: root.tint; image-fit: contain; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
    Tooltip { Text { text: root.label; } }
    animate background { duration: 100ms; }
}
export struct ServerRow { profile-index: int, name: string, host: string, status: string, last-opened: string, default-server: bool }
export component ServerManager inherits Rectangle {
    in property <[ServerRow]> servers;
    in-out property <int> selected: -1;
    callback action(string);
    in-out property <int> copied-host: -1;
    changed servers => { root.copied-host = -1; }
    background: #ffffff;
    border-radius: 8px;
    VerticalLayout {
        padding: 22px;
        spacing: 12px;
        SelectableText { text: @tr("Servers"); font-size: 22px; font-weight: 700; text-color: #192b42; }
        HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 12px;
            SelectableText { text: @tr("Name"); width: 220px; }
            SelectableText { text: @tr("Host"); width: 260px; }
            SelectableText { text: @tr("Status"); width: 100px; }
            SelectableText { text: @tr("Last opened"); horizontal-stretch: 1; }
            SelectableText { text: @tr("Actions"); width: 76px; horizontal-alignment: center; }
        }
        ListView {
            for server[i] in root.servers: Rectangle {
                height: 64px;
                background: root.selected == server.profile-index ? #e1f1f5 : (Math.mod(i,2) == 0 ? #f6f9fc : #ffffff);
                accessible-role: button; accessible-label: server.name + " " + server.host;
                accessible-action-default => { root.selected = server.profile-index; }
                forward-focus: row-focus;
                row-focus := FocusScope { key-pressed(event) => {
                    if event.text == Key.Return || event.text == " " { root.selected = server.profile-index; return accept; }
                    return reject;
                } }
                TouchArea { mouse-cursor: default; clicked => { row-focus.focus(); root.selected = server.profile-index; } }
                HorizontalLayout {
                    padding: 8px; spacing: 12px;
                    HorizontalLayout { width: 220px; spacing: 8px;
                        VerticalLayout { width: 28px; alignment: center;
                            RowIconButton { icon: server.default-server ? @image-url("../../assets/icons/star-filled.svg") : @image-url("../../assets/icons/star.svg"); tint: server.default-server ? #d49a18 : #8b9bac; label: server.default-server ? @tr("Default server") : @tr("Set Default"); clicked => { root.selected = server.profile-index; root.action("default"); } }
                        }
                        SelectableText { text: server.name; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    }
                    HorizontalLayout { width: 260px; spacing: 8px;
                        SelectableText { text: server.host; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                        VerticalLayout { width: 28px; alignment: center; CopyHostButton { copied: root.copied-host == i; clicked => { host-value.copy-all(); root.copied-host = i; } } }
                        host-value := SelectableText { visible: false; text: server.host; }
                    }
                    SelectableText { text-color: #253b52; text: server.status; width: 100px; vertical-alignment: center; overflow: elide; }
                    SelectableText { text-color: #253b52; text: server.last-opened; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    HorizontalLayout { width: 76px; spacing: 8px; alignment: center;
                        VerticalLayout { width: 28px; alignment: center; RowIconButton { icon: @image-url("../../assets/icons/edit.svg"); tint: #287fa1; label: @tr("Edit"); clicked => { root.selected = server.profile-index; root.action("edit"); } } }
                        VerticalLayout { width: 28px; alignment: center; RowIconButton { icon: @image-url("../../assets/icons/delete.svg"); tint: #c65b62; label: @tr("Remove"); clicked => { root.selected = server.profile-index; root.action("remove"); } } }
                    }
                }
            }
        }
        SelectableText { text: @tr("The starred server is your default and appears first. Opening another server keeps this choice."); text-color: #62748a; }
        HorizontalLayout { spacing: 12px;
            Button { text: @tr("New"); clicked => { root.action("new"); } }
            Rectangle { horizontal-stretch: 1; }
            Button { text: @tr("Cancel"); clicked => { root.action("cancel"); } }
            Button { text: @tr("Open"); enabled: root.selected >= 0; clicked => { root.action("open"); } }
        }
    }
}
