import { SelectableText } from "selectable-text.slint";
export { SplashWindow } from "splash.slint";
import { ServerForm } from "dialogs/server-form.slint";
import { ServerManager, ServerRow } from "dialogs/server-manager.slint";
export { ServerRow } from "dialogs/server-manager.slint";
import { Button, ListView, AboutSlint } from "std-widgets.slint";

export struct AppEntry {
    name: string,
    note: string,
    containers: int,
    sources: int,
    dbs: int,
    needs-review: bool,
}

export struct DataEntry {
    title: string,
    location: string,
    detail: string,
    decision: string,
    database: bool,
    caution: bool,
}

component NavLine inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback pressed;
    height: 42px;
    background: active ? #213550 : transparent;
    border-radius: 6px;
    Text {
        x: 16px;
        width: parent.width - 20px;
        height: parent.height;
        text: label;
        color: active ? #ffffff : #9aaec6;
        font-size: 13px;
        font-weight: active ? 700 : 450;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.pressed(); } }
}

export component ContainerSafeWindow inherits Window {
    title: "ContainerSafe " + root.app-version + " — " + root.active-server;
    preferred-width: 1260px;
    preferred-height: 790px;
    min-width: 1060px;
    min-height: 610px;
    background: #0d1522;
    default-font-family: "Segoe UI";
    default-font-size: 13px;

    in-out property <[AppEntry]> applications: [];
    in-out property <[DataEntry]> entries: [];
    in-out property <int> active-index: -1;
    in-out property <string> selected-name: "Select an application";
    in-out property <string> selected-summary: "Choose a stack on the left";
    in-out property <string> selected-warning: "";
    in-out property <string> status-message: "Ready";
    in-out property <string> validation-message: "Not validated";
    in-out property <int> total-apps: 0;
    in-out property <int> total-containers: 0;
    in-out property <int> total-sources: 0;
    in-out property <int> total-dbs: 0;
    in-out property <bool> dirty: false;
    in-out property <bool> loading: false;
    in-out property <int> page: 0;

    callback select-app(int);
    callback cycle-decision(int);
    callback refresh-inventory();
    callback save-selection();
    callback validate-selection();

    in-out property <string> app-version;
    in-out property <string> active-server: "Disconnected";
    in-out property <int> dialog: 0;
    in-out property <[ServerRow]> servers;
    in-out property <int> selected-server: -1;
    in-out property <string> form-name;
    in-out property <string> form-host;
    in-out property <string> form-port: "22";
    in-out property <string> form-user;
    in-out property <int> form-auth: 0;
    in-out property <string> form-key;
    in-out property <string> form-secret;
    in-out property <bool> form-remember;
    in-out property <int> form-docker;
    in-out property <string> form-timeout: "10";
    in-out property <string> connection-result: "Not tested";
    in-out property <bool> test-busy;
    in-out property <bool> test-passed;
    in-out property <string> host-question;
    in-out property <bool> host-changed;
    callback server-action(string);
    callback form-edited();
    callback test-server();
    callback save-server();
    callback browse-key();
    callback trust-host();
    MenuBar {
        Menu { title: "File";
            MenuItem { title: "New Server..."; shortcut: @keys(Control + N); enabled: root.dialog == 0 && !root.loading; activated => { root.server-action("new"); } }
            MenuItem { title: "Servers..."; shortcut: @keys(Control + Shift + S); enabled: root.dialog == 0 && !root.loading; activated => { root.server-action("servers"); } }
            MenuSeparator {}
            MenuItem { title: "Quit"; shortcut: @keys(Control + Q); activated => { root.server-action("quit"); } }
        }
        Menu { title: "Help";
            MenuItem { title: "Documentation"; activated => { root.server-action("docs"); } }
            MenuItem { title: "About ContainerSafe"; activated => { root.dialog = 4; } }
        }
    }
    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape && root.dialog != 0 { root.server-action("cancel"); return accept; }
            return reject;
        }
    FocusScope {
    enabled: root.dialog == 0;
    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 205px;
            background: #111e30;
            VerticalLayout {
                padding: 14px;
                spacing: 8px;
                Rectangle {
                    height: 64px;
                    HorizontalLayout {
                        spacing: 12px;
                        Rectangle {
                            width: 42px;
                            height: 42px;
                            background: #2865a0;
                            border-radius: 9px;
                            SelectableText {
                                text: "CS";
                                text-color: white;
                                font-size: 16px;
                                font-weight: 800;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        VerticalLayout {
                            spacing: 1px;
                            SelectableText { text: "ContainerSafe " + root.app-version; font-weight: 700; text-color: #f1f6ff; font-size: 15px; }
                            SelectableText { text: root.active-server; overflow: elide; text-color: #8da1bc; font-size: 10px; }
                        }
                    }
                }
                Rectangle { height: 1px; background: #2a3b51; }
                SelectableText { height: 28px; text: "WORKSPACE"; font-size: 10px; font-weight: 700; text-color: #6f88a8; vertical-alignment: center; }
                NavLine { label: "Applications"; active: root.page == 0; pressed => { root.page = 0; } }
                NavLine { label: "Backup plans"; active: root.page == 1; pressed => { root.page = 1; } }
                NavLine { label: "Activity"; active: root.page == 2; pressed => { root.page = 2; } }
                Rectangle { vertical-stretch: 1; }
                Rectangle { height: 1px; background: #2a3b51; }
                NavLine { label: "About"; active: root.page == 3; pressed => { root.page = 3; } }
                SelectableText {
                    height: 32px;
                    text: "DEVELOPMENT PREVIEW  |  READ ONLY";
                    text-color: #7890aa;
                    font-size: 9px;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            background: #0d1522;
            VerticalLayout {
                spacing: 0px;

                Rectangle {
                    height: 64px;
                    background: #142136;
                    HorizontalLayout {
                        padding-left: 22px;
                        padding-right: 18px;
                        spacing: 12px;
                        SelectableText {
                            text: root.page == 3 ? "About ContainerSafe" : root.page == 2 ? "Activity" : root.page == 1 ? "Backup plans" : "Applications";
                            font-size: 20px;
                            font-weight: 700;
                            text-color: #f1f5fe;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: "Retry / Refresh";
                            enabled: !root.loading && root.dialog == 0;
                            clicked => { root.refresh-inventory(); }
                        }
                        Button {
                            text: root.dirty ? "Save changes *" : "Save selections";
                            enabled: !root.loading && root.dirty && root.dialog == 0;
                            clicked => { root.save-selection(); }
                        }
                        Button {
                            text: "Validate";
                            enabled: !root.loading && root.dialog == 0;
                            clicked => { root.validate-selection(); }
                        }
                    }
                }

                if root.page == 0 || root.page == 1 : Rectangle {
                    background: #0d1522;
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 0px;
                        Rectangle {
                            height: 76px;
                            background: #0f1b2a;
                            HorizontalLayout {
                                padding-left: 24px;
                                padding-right: 24px;
                                spacing: 22px;
                                VerticalLayout {
                                    spacing: 0px;
                                    SelectableText { text: "APPLICATIONS"; text-color: #8299b5; font-size: 10px; }
                                    SelectableText { text: root.total-apps; text-color: #e9f2ff; font-size: 22px; font-weight: 700; }
                                }
                                Rectangle { width: 1px; background: #29394d; }
                                VerticalLayout {
                                    spacing: 0px;
                                    SelectableText { text: "CONTAINERS"; text-color: #8299b5; font-size: 10px; }
                                    SelectableText { text: root.total-containers; text-color: #e9f2ff; font-size: 22px; font-weight: 700; }
                                }
                                Rectangle { width: 1px; background: #29394d; }
                                VerticalLayout {
                                    spacing: 0px;
                                    SelectableText { text: "DATA SOURCES"; text-color: #8299b5; font-size: 10px; }
                                    SelectableText { text: root.total-sources; text-color: #e9f2ff; font-size: 22px; font-weight: 700; }
                                }
                                Rectangle { width: 1px; background: #29394d; }
                                VerticalLayout {
                                    spacing: 0px;
                                    SelectableText { text: "DATABASES"; text-color: #8299b5; font-size: 10px; }
                                    SelectableText { text: root.total-dbs; text-color: #e9f2ff; font-size: 22px; font-weight: 700; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                SelectableText {
                                    text: "Backup execution disabled";
                                    text-color: #e4b77c;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 0px;
                            Rectangle {
                                width: 340px;
                                background: #101c2d;
                                VerticalLayout {
                                    padding-top: 12px;
                                    spacing: 0px;
                                    Rectangle {
                                        height: 42px;
                                        SelectableText {
                                            x: 18px;
                                            text: "DOCKER APPLICATIONS";
                                            text-color: #8aa2c0;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                    ListView {
                                        for app[index] in root.applications: Rectangle {
                                            height: 64px;
                                            background: root.active-index == index ? #24405e : (Math.mod(index, 2) == 0 ? #132136 : #101c2d);
                                            TouchArea {
                                                clicked => { root.select-app(index); }
                                            }
                                            Rectangle {
                                                x: 12px;
                                                y: 8px;
                                                width: 3px;
                                                height: 48px;
                                                background: root.active-index == index ? #65b5fa : transparent;
                                                border-radius: 2px;
                                            }
                                            VerticalLayout {
                                                padding-left: 25px;
                                                padding-right: 12px;
                                                padding-top: 10px;
                                                padding-bottom: 9px;
                                                spacing: 4px;
                                                SelectableText {
                                                    text: app.name;
                                                    activated => { root.select-app(index); }
                                                    font-weight: 650;
                                                    font-size: 13px;
                                                    text-color: #ecf3ff;
                                                    overflow: elide;
                                                }
                                                SelectableText {
                                                    text: app.note;
                                                    activated => { root.select-app(index); }
                                                    font-size: 11px;
                                                    text-color: #8ca4c0;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                background: #0d1522;
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    spacing: 0px;
                                    Rectangle {
                                        height: 98px;
                                        background: #142136;
                                        VerticalLayout {
                                            padding-left: 24px;
                                            padding-right: 18px;
                                            padding-top: 13px;
                                            spacing: 6px;
                                            SelectableText {
                                                text: root.selected-name;
                                                text-color: #f3f7ff;
                                                font-size: 19px;
                                                font-weight: 700;
                                                overflow: elide;
                                            }
                                            SelectableText {
                                                text: root.selected-summary;
                                                text-color: #9eb4ce;
                                                font-size: 12px;
                                                overflow: elide;
                                            }
                                            SelectableText {
                                                text: root.selected-warning;
                                                text-color: #dcb37a;
                                                font-size: 11px;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                    Rectangle {
                                        height: 40px;
                                        background: #17253a;
                                        HorizontalLayout {
                                            padding-left: 16px;
                                            padding-right: 16px;
                                            spacing: 8px;
                                            SelectableText { text: "SOURCE / DATABASE"; horizontal-stretch: 1; text-color: #a6bdd9; font-size: 10px; font-weight: 700; vertical-alignment: center; }
                                            SelectableText { text: "DECISION"; width: 134px; text-color: #a6bdd9; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                    ListView {
                                        for entry[index] in root.entries: Rectangle {
                                            height: 73px;
                                            background: Math.mod(index, 2) == 0 ? #111e30 : #0e1929;
                                            HorizontalLayout {
                                                padding-left: 15px;
                                                padding-right: 16px;
                                                spacing: 9px;
                                                Rectangle {
                                                    width: 52px;
                                                    height: 22px;
                                                    background: entry.database ? #3b2e4b : #203e4c;
                                                    border-radius: 4px;
                                                    SelectableText {
                                                        text: entry.database ? "DB" : "DATA";
                                                        text-color: entry.database ? #e5beff : #9cd9d4;
                                                        font-size: 10px;
                                                        font-weight: 750;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    spacing: 3px;
                                                    SelectableText { text: entry.title; text-color: #f0f5fc; font-size: 12px; font-weight: 600; overflow: elide; }
                                                    SelectableText { text: entry.location; text-color: #91a6bf; font-size: 10px; overflow: elide; }
                                                    SelectableText { text: entry.detail; text-color: entry.caution ? #dfa66a : #718cac; font-size: 10px; overflow: elide; }
                                                }
                                                Button {
                                                    width: 132px;
                                                    text: entry.decision;
                                                    enabled: !root.loading && root.dialog == 0;
                                                    clicked => { root.cycle-decision(index); }
                                                }
                                            }
                                            Rectangle { y: 72px; width: parent.width; height: 1px; background: #223249; }
                                        }
                                    }
                                    Rectangle {
                                        height: 52px;
                                        background: #152338;
                                        SelectableText {
                                            x: 18px;
                                            width: parent.width - 36px;
                                            height: parent.height;
                                            text: "Click a decision to cycle Pending / Include / Exclude (or Logical dump for PostgreSQL).";
                                            text-color: #94acc8;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.page == 2 : Rectangle {
                    vertical-stretch: 1;
                    background: #0d1522;
                    VerticalLayout {
                        padding: 38px;
                        spacing: 14px;
                        SelectableText { text: "Activity history"; text-color: #f5f7ff; font-size: 22px; font-weight: 700; }
                        SelectableText { text: "No backup jobs have been executed. Job scheduling and Restic execution will be added after the core refactor."; text-color: #a2b5cd; wrap: word-wrap; }
                    }
                }

                if root.page == 3 : Rectangle {
                    vertical-stretch: 1;
                    background: #0d1522;
                    VerticalLayout {
                        padding: 38px;
                        spacing: 18px;
                        SelectableText { text: "ContainerSafe Native " + root.app-version; text-color: #f5f7ff; font-size: 22px; font-weight: 700; }
                        SelectableText { text: "Rust + Slint. No web browser, HTML, JavaScript, React, or Tauri runtime."; text-color: #b2c4d9; font-size: 14px; }
                        SelectableText { text: "Developer preview: discovery, planning, selection and validation only. Backup execution disabled."; text-color: #b2c4d9; wrap: word-wrap; }
                        SelectableText { text: "Built with Slint"; font-size: 13px; text-color: #9cb7d5; }
                        AboutSlint { width: 180px; height: 42px; }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                Rectangle {
                    height: 36px;
                    background: #101d2e;
                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        spacing: 18px;
                        SelectableText {
                            text: root.status-message;
                            text-color: #bed0e6;
                            font-size: 11px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        SelectableText {
                            text: root.validation-message;
                            text-color: #9db7d5;
                            font-size: 11px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
    }
    // Modal scrim consumes pointer input; all application actions are also guarded in Rust.
    if root.dialog != 0 : Rectangle {
        background: #0009;
        TouchArea {}
        if root.dialog == 1 : ServerForm {
            x: (parent.width - self.width) / 2; y: 12px;
            width: min(820px, parent.width - 48px); height: parent.height - 24px;
            server-name <=> root.form-name; host <=> root.form-host; port <=> root.form-port;
            username <=> root.form-user; authentication <=> root.form-auth; key-path <=> root.form-key;
            secret <=> root.form-secret; remember <=> root.form-remember; docker-access <=> root.form-docker;
            timeout <=> root.form-timeout; result: root.connection-result; busy: root.test-busy; tested: root.test-passed;
            edited => { root.form-edited(); } test => { root.test-server(); } save => { root.save-server(); }
            browse => { root.browse-key(); } cancel => { root.server-action("cancel"); }
            init => { self.focus-first(); }
        }
        if root.dialog == 2 : ServerManager {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: 920px; height: 470px;
            servers: root.servers; selected <=> root.selected-server;
            action(action) => { root.server-action(action); }
        }
        if root.dialog == 3 || root.dialog == 5 : Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: 690px; height: 320px; background: #16263b; border-radius: 8px;
            VerticalLayout {
                padding: 24px; spacing: 14px;
                SelectableText { text: root.dialog == 5 ? "Remove server?" : root.host-changed ? "HOST KEY CHANGED — connection blocked" : "Trust SSH host identity?"; text-color: #efba88; font-weight: 700; font-size: 18px; }
                SelectableText { text: root.host-question; wrap: word-wrap; text-color: #d1e1f4; }
                HorizontalLayout {
                    Button { text: "Cancel / Reject"; clicked => { root.server-action("cancel"); } }
                    Button { text: root.dialog == 5 ? "Remove profile and credential" : root.host-changed ? "Approve reviewed replacement" : "Trust this host";
                        clicked => { if root.dialog == 5 { root.server-action("confirm-remove"); } else { root.trust-host(); } }
                    }
                }
            }
        }
        if root.dialog == 4 : Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: 560px; height: 350px; background: #16263b;
            VerticalLayout {
                padding: 28px; spacing: 16px;
                SelectableText { text-color: #f0f5ff; text: "ContainerSafe " + root.app-version; font-size: 24px; font-weight: 700; }
                SelectableText { text-color: #b2c4d9; text: "Native Docker backup readiness manager. Rust + Slint."; wrap: word-wrap; }
                AboutSlint { height: 110px; }
                Button { text: "Close"; clicked => { root.server-action("cancel"); } }
            }
        }
    }

    }
}
