export { SplashWindow } from "splash.slint";
import { Button, ListView, AboutSlint } from "std-widgets.slint";

export struct AppEntry {
    name: string,
    note: string,
    containers: int,
    sources: int,
    dbs: int,
    needs-review: bool,
}

export struct DataEntry {
    title: string,
    location: string,
    detail: string,
    decision: string,
    database: bool,
    caution: bool,
}

component NavLine inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback pressed;
    height: 42px;
    background: active ? #213550 : transparent;
    border-radius: 6px;
    Text {
        x: 16px;
        width: parent.width - 20px;
        height: parent.height;
        text: label;
        color: active ? #ffffff : #9aaec6;
        font-size: 13px;
        font-weight: active ? 700 : 450;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.pressed(); } }
}

export component ContainerSafeWindow inherits Window {
    title: "ContainerSafe - Backup Manager";
    preferred-width: 1260px;
    preferred-height: 790px;
    min-width: 1060px;
    min-height: 610px;
    background: #0d1522;
    default-font-family: "Segoe UI";
    default-font-size: 13px;

    in-out property <[AppEntry]> applications: [];
    in-out property <[DataEntry]> entries: [];
    in-out property <int> active-index: -1;
    in-out property <string> selected-name: "Select an application";
    in-out property <string> selected-summary: "Choose a stack on the left";
    in-out property <string> selected-warning: "";
    in-out property <string> status-message: "Ready";
    in-out property <string> validation-message: "Not validated";
    in-out property <int> total-apps: 0;
    in-out property <int> total-containers: 0;
    in-out property <int> total-sources: 0;
    in-out property <int> total-dbs: 0;
    in-out property <bool> dirty: false;
    in-out property <bool> loading: false;
    in-out property <int> page: 0;

    callback select-app(int);
    callback cycle-decision(int);
    callback refresh-inventory();
    callback save-selection();
    callback validate-selection();

    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 205px;
            background: #111e30;
            VerticalLayout {
                padding: 14px;
                spacing: 8px;
                Rectangle {
                    height: 64px;
                    HorizontalLayout {
                        spacing: 12px;
                        Rectangle {
                            width: 42px;
                            height: 42px;
                            background: #2865a0;
                            border-radius: 9px;
                            Text {
                                text: "CS";
                                color: white;
                                font-size: 16px;
                                font-weight: 800;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        VerticalLayout {
                            spacing: 1px;
                            Text { text: "ContainerSafe"; font-weight: 700; color: #f1f6ff; font-size: 15px; }
                            Text { text: "BACKUP MANAGER"; color: #8da1bc; font-size: 10px; }
                        }
                    }
                }
                Rectangle { height: 1px; background: #2a3b51; }
                Text { height: 28px; text: "WORKSPACE"; font-size: 10px; font-weight: 700; color: #6f88a8; vertical-alignment: center; }
                NavLine { label: "Applications"; active: root.page == 0; pressed => { root.page = 0; } }
                NavLine { label: "Backup plans"; active: root.page == 1; pressed => { root.page = 1; } }
                NavLine { label: "Activity"; active: root.page == 2; pressed => { root.page = 2; } }
                Rectangle { vertical-stretch: 1; }
                Rectangle { height: 1px; background: #2a3b51; }
                NavLine { label: "About"; active: root.page == 3; pressed => { root.page = 3; } }
                Text {
                    height: 32px;
                    text: "DEVELOPMENT PREVIEW  |  READ ONLY";
                    color: #7890aa;
                    font-size: 9px;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            background: #0d1522;
            VerticalLayout {
                spacing: 0px;

                Rectangle {
                    height: 64px;
                    background: #142136;
                    HorizontalLayout {
                        padding-left: 22px;
                        padding-right: 18px;
                        spacing: 12px;
                        Text {
                            text: root.page == 3 ? "About ContainerSafe" : root.page == 2 ? "Activity" : root.page == 1 ? "Backup plans" : "Applications";
                            font-size: 20px;
                            font-weight: 700;
                            color: #f1f5fe;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: "Refresh Docker";
                            enabled: !root.loading;
                            clicked => { root.refresh-inventory(); }
                        }
                        Button {
                            text: root.dirty ? "Save changes *" : "Save selections";
                            enabled: !root.loading && root.dirty;
                            clicked => { root.save-selection(); }
                        }
                        Button {
                            text: "Validate";
                            enabled: !root.loading;
                            clicked => { root.validate-selection(); }
                        }
                    }
                }

                if root.page == 0 || root.page == 1 : Rectangle {
                    background: #0d1522;
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 0px;
                        Rectangle {
                            height: 76px;
                            background: #0f1b2a;
                            HorizontalLayout {
                                padding-left: 24px;
                                padding-right: 24px;
                                spacing: 22px;
                                VerticalLayout {
                                    spacing: 0px;
                                    Text { text: "APPLICATIONS"; color: #8299b5; font-size: 10px; }
                                    Text { text: root.total-apps; color: #e9f2ff; font-size: 22px; font-weight: 700; }
                                }
                                Rectangle { width: 1px; background: #29394d; }
                                VerticalLayout {
                                    spacing: 0px;
                                    Text { text: "CONTAINERS"; color: #8299b5; font-size: 10px; }
                                    Text { text: root.total-containers; color: #e9f2ff; font-size: 22px; font-weight: 700; }
                                }
                                Rectangle { width: 1px; background: #29394d; }
                                VerticalLayout {
                                    spacing: 0px;
                                    Text { text: "DATA SOURCES"; color: #8299b5; font-size: 10px; }
                                    Text { text: root.total-sources; color: #e9f2ff; font-size: 22px; font-weight: 700; }
                                }
                                Rectangle { width: 1px; background: #29394d; }
                                VerticalLayout {
                                    spacing: 0px;
                                    Text { text: "DATABASES"; color: #8299b5; font-size: 10px; }
                                    Text { text: root.total-dbs; color: #e9f2ff; font-size: 22px; font-weight: 700; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text {
                                    text: "Backup execution disabled";
                                    color: #e4b77c;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 0px;
                            Rectangle {
                                width: 340px;
                                background: #101c2d;
                                VerticalLayout {
                                    padding-top: 12px;
                                    spacing: 0px;
                                    Rectangle {
                                        height: 42px;
                                        Text {
                                            x: 18px;
                                            text: "DOCKER APPLICATIONS";
                                            color: #8aa2c0;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                    ListView {
                                        for app[index] in root.applications: Rectangle {
                                            height: 64px;
                                            background: root.active-index == index ? #24405e : (Math.mod(index, 2) == 0 ? #132136 : #101c2d);
                                            Rectangle {
                                                x: 12px;
                                                y: 8px;
                                                width: 3px;
                                                height: 48px;
                                                background: root.active-index == index ? #65b5fa : transparent;
                                                border-radius: 2px;
                                            }
                                            VerticalLayout {
                                                padding-left: 25px;
                                                padding-right: 12px;
                                                padding-top: 10px;
                                                padding-bottom: 9px;
                                                spacing: 4px;
                                                Text {
                                                    text: app.name;
                                                    font-weight: 650;
                                                    font-size: 13px;
                                                    color: #ecf3ff;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: app.note;
                                                    font-size: 11px;
                                                    color: #8ca4c0;
                                                    overflow: elide;
                                                }
                                            }
                                            TouchArea {
                                                clicked => { root.select-app(index); }
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                background: #0d1522;
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    spacing: 0px;
                                    Rectangle {
                                        height: 98px;
                                        background: #142136;
                                        VerticalLayout {
                                            padding-left: 24px;
                                            padding-right: 18px;
                                            padding-top: 13px;
                                            spacing: 6px;
                                            Text {
                                                text: root.selected-name;
                                                color: #f3f7ff;
                                                font-size: 19px;
                                                font-weight: 700;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: root.selected-summary;
                                                color: #9eb4ce;
                                                font-size: 12px;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: root.selected-warning;
                                                color: #dcb37a;
                                                font-size: 11px;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                    Rectangle {
                                        height: 40px;
                                        background: #17253a;
                                        HorizontalLayout {
                                            padding-left: 16px;
                                            padding-right: 16px;
                                            spacing: 8px;
                                            Text { text: "SOURCE / DATABASE"; horizontal-stretch: 1; color: #a6bdd9; font-size: 10px; font-weight: 700; vertical-alignment: center; }
                                            Text { text: "DECISION"; width: 134px; color: #a6bdd9; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                    ListView {
                                        for entry[index] in root.entries: Rectangle {
                                            height: 73px;
                                            background: Math.mod(index, 2) == 0 ? #111e30 : #0e1929;
                                            HorizontalLayout {
                                                padding-left: 15px;
                                                padding-right: 16px;
                                                spacing: 9px;
                                                Rectangle {
                                                    width: 52px;
                                                    height: 22px;
                                                    background: entry.database ? #3b2e4b : #203e4c;
                                                    border-radius: 4px;
                                                    Text {
                                                        text: entry.database ? "DB" : "DATA";
                                                        color: entry.database ? #e5beff : #9cd9d4;
                                                        font-size: 10px;
                                                        font-weight: 750;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    spacing: 3px;
                                                    Text { text: entry.title; color: #f0f5fc; font-size: 12px; font-weight: 600; overflow: elide; }
                                                    Text { text: entry.location; color: #91a6bf; font-size: 10px; overflow: elide; }
                                                    Text { text: entry.detail; color: entry.caution ? #dfa66a : #718cac; font-size: 10px; overflow: elide; }
                                                }
                                                Button {
                                                    width: 132px;
                                                    text: entry.decision;
                                                    enabled: !root.loading;
                                                    clicked => { root.cycle-decision(index); }
                                                }
                                            }
                                            Rectangle { y: 72px; width: parent.width; height: 1px; background: #223249; }
                                        }
                                    }
                                    Rectangle {
                                        height: 52px;
                                        background: #152338;
                                        Text {
                                            x: 18px;
                                            width: parent.width - 36px;
                                            height: parent.height;
                                            text: "Click a decision to cycle Pending / Include / Exclude (or Logical dump for PostgreSQL).";
                                            color: #94acc8;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.page == 2 : Rectangle {
                    vertical-stretch: 1;
                    background: #0d1522;
                    VerticalLayout {
                        padding: 38px;
                        spacing: 14px;
                        Text { text: "Activity history"; color: #f5f7ff; font-size: 22px; font-weight: 700; }
                        Text { text: "No backup jobs have been executed. Job scheduling and Restic execution will be added after the core refactor."; color: #a2b5cd; wrap: word-wrap; }
                    }
                }

                if root.page == 3 : Rectangle {
                    vertical-stretch: 1;
                    background: #0d1522;
                    VerticalLayout {
                        padding: 38px;
                        spacing: 18px;
                        Text { text: "ContainerSafe Native"; color: #f5f7ff; font-size: 22px; font-weight: 700; }
                        Text { text: "Rust + Slint. No web browser, HTML, JavaScript, React, or Tauri runtime."; color: #b2c4d9; font-size: 14px; }
                        Text { text: "Developer preview: discovery, planning, selection and validation only. Backup execution disabled."; color: #b2c4d9; wrap: word-wrap; }
                        Text { text: "Built with Slint"; font-size: 13px; color: #9cb7d5; }
                        AboutSlint { width: 180px; height: 42px; }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                Rectangle {
                    height: 36px;
                    background: #101d2e;
                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        spacing: 18px;
                        Text {
                            text: root.status-message;
                            color: #bed0e6;
                            font-size: 11px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: root.validation-message;
                            color: #9db7d5;
                            font-size: 11px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}
