import { SelectableText } from "selectable-text.slint";
// ContainerSafe native splash screen — Slint 1.18.x.
// The background picture is bundled at compile time.
// Progress and status are genuine UI properties updated from Rust.
export component SplashWindow inherits Window {
    title: "ContainerSafe — Starting";
    width: 1100px;
    height: 706px;
    background: #071526;
    default-font-family: "Segoe UI";

    in-out property <int> loading-progress: 0;
    in-out property <string> loading-message: "Initializing ContainerSafe...";

    Image {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height - 92px;
        source: @image-url("../assets/splash.png");
        image-fit: contain;
    }

    Rectangle {
        x: 0px;
        y: parent.height - 92px;
        width: parent.width;
        height: 92px;
        background: #071526;

        SelectableText {
            x: 28px;
            y: 10px;
            width: parent.width - 110px;
            height: 30px;
            text: root.loading-message;
            text-color: #dcecff;
            font-size: 14px;
            vertical-alignment: center;
        }

        SelectableText {
            x: parent.width - 76px;
            y: 10px;
            width: 48px;
            height: 30px;
            text: root.loading-progress + "%";
            text-color: #5cd5ff;
            font-weight: 700;
            font-size: 14px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        Rectangle {
            x: 28px;
            y: 47px;
            width: parent.width - 56px;
            height: 8px;
            border-radius: 4px;
            background: #24364f;

            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width * root.loading-progress / 100;
                height: parent.height;
                border-radius: 4px;
                background: #26c1f3;
            }
        }

        SelectableText {
            x: 28px;
            y: 65px;
            width: parent.width - 56px;
            height: 18px;
            text: "Local startup checks only · No Docker changes performed";
            text-color: #809ab7;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}
