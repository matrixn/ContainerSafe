import { SelectableText } from "selectable-text.slint";
// ContainerSafe native splash screen — Slint 1.18.x.
// The background picture is bundled at compile time.
// Progress and status are genuine UI properties updated from Rust.
export component SplashWindow inherits Window {
    title: @tr("ContainerSafe — Starting");
    width: 550px;
    height: 353px;
    no-frame: true;
    background: #071526;
    default-font-family: "Segoe UI";

    in-out property <int> loading-progress: 0;
    in-out property <string> loading-message: @tr("Initializing ContainerSafe...");

    Image {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height - 64px;
        source: @image-url("../assets/splash.png");
        image-fit: contain;
    }

    Rectangle {
        x: 0px;
        y: parent.height - 64px;
        width: parent.width;
        height: 64px;
        background: #071526;

        SelectableText {
            x: 14px;
            y: 2px;
            width: parent.width - 80px;
            height: 24px;
            text: root.loading-message;
            text-color: #dcecff;
            font-size: 12px;
            vertical-alignment: center;
        }

        SelectableText {
            x: parent.width - 60px;
            y: 2px;
            width: 46px;
            height: 24px;
            text: root.loading-progress + "%";
            text-color: #5cd5ff;
            font-weight: 700;
            font-size: 12px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        Rectangle {
            x: 14px;
            y: 30px;
            width: parent.width - 28px;
            height: 4px;
            border-radius: 4px;
            background: #24364f;

            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width * root.loading-progress / 100;
                height: parent.height;
                border-radius: 4px;
                background: #26c1f3;
            }
        }

        SelectableText {
            x: 14px;
            y: 42px;
            width: parent.width - 28px;
            height: 18px;
            text: @tr("Local startup checks only · No Docker changes performed");
            text-color: #809ab7;
            font-size: 9px;
            vertical-alignment: center;
        }
    }
}
