import { SelectableText } from "selectable-text.slint";

export global Theme {
    out property <color> canvas: #f4f7fb;
    out property <color> surface: #ffffff;
    out property <color> ink: #192b42;
    out property <color> muted: #62748a;
    out property <color> line: #dce4ed;
    out property <color> accent: #176b83;
}

export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> quiet: false;
    in property <bool> enabled: true;
    callback clicked;
    min-width: label.preferred-width + 28px; preferred-width: label.preferred-width + 28px;
    height: 36px; border-radius: 7px;
    background: !root.enabled ? #edf1f5 : root.primary ? (touch.pressed ? #0e5064 : touch.has-hover ? #125c72 : Theme.accent) : (touch.pressed ? #dbe7ef : touch.has-hover ? #edf4f9 : root.quiet ? transparent : #ffffff);
    border-width: root.quiet ? 0px : 1px;
    border-color: !root.enabled ? #e1e7ee : root.primary ? #125c72 : focus.has-focus ? Theme.accent : #b8c9d8;
    accessible-role: button; accessible-label: root.text;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    focus := FocusScope { enabled: root.enabled; key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.clicked(); return accept; } return reject; } }
    label := Text { text: root.text; color: !root.enabled ? #8290a0 : root.primary ? white : #27465d; font-size: 13px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { focus.focus(); root.clicked(); } }
    animate background { duration: 100ms; }
}
export component ChoiceBox inherits Rectangle {
    in property <[string]> model;
    in property <bool> enabled: true;
    in-out property <int> current-index: 0;
    private property <int> popup-index: root.current-index;
    out property <string> current-value: root.model[root.current-index];
    callback selected(string);
    height: 36px; min-width: 120px; border-radius: 7px; border-width: 1px;
    border-color: focus.has-focus ? Theme.accent : #bdcdda;
    background: !root.enabled ? #edf1f5 : touch.has-hover ? #edf5f9 : #f8fafc;
    accessible-role: combobox; accessible-enabled: root.enabled;
    accessible-value: root.current-value; accessible-expandable: true;
    accessible-action-expand => { if root.enabled { root.open-popup(); } }
    public function open-popup() { root.popup-index = root.current-index; popup.show(); }
    forward-focus: focus;
    focus := FocusScope { enabled: root.enabled; key-pressed(event) => {
        if event.text == Key.Return || event.text == " " || event.text == Key.DownArrow { root.open-popup(); return accept; }
        return reject;
    } }
    HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 8px;
        Text { text: root.current-value; color: root.enabled ? #35546a : #8b9aab; font-size: 13px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
        Rectangle { width: 12px; Image { y: (parent.height - 12px) / 2; width: 12px; height: 12px; source: @image-url("../assets/icons/chevron-down.svg"); image-fit: contain; } }
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { focus.focus(); root.open-popup(); } }
    popup := PopupWindow {
        y: root.height + 3px; width: root.width; height: root.model.length * 36px + 8px;
        Rectangle { background: white; border-radius: 7px; border-width: 1px; border-color: #b8cbd8;
            init => { popup-focus.focus(); }
            popup-focus := FocusScope { key-pressed(event) => {
                if event.text == Key.DownArrow { root.popup-index = min(root.popup-index + 1, root.model.length - 1); return accept; }
                if event.text == Key.UpArrow { root.popup-index = max(root.popup-index - 1, 0); return accept; }
                if event.text == Key.Return || event.text == " " { root.current-index = root.popup-index; root.selected(root.current-value); popup.close(); return accept; }
                if event.text == Key.Escape { popup.close(); return accept; }
                return reject;
            } }
            VerticalLayout { padding: 4px; spacing: 0px;
                for value[index] in root.model: Rectangle {
                    height: 36px; border-radius: 4px;
                    background: item-touch.has-hover ? #e6f2f7 : index == root.popup-index ? #f0f5f9 : white;
                    Text { x: 10px; width: parent.width - 20px; text: value; color: #27465d; font-size: 13px; vertical-alignment: center; overflow: elide; }
                    item-touch := TouchArea { mouse-cursor: pointer; clicked => { root.current-index = index; root.selected(value); popup.close(); } }
                }
            }
        }
    }
}
export component ToggleCheck inherits Rectangle {
    in property <string> text; in property <bool> enabled: true;
    in-out property <bool> checked: false; callback toggled;
    height: 28px; min-width: label.preferred-width + 32px;
    forward-focus: focus;
    accessible-role: checkbox; accessible-label: root.text;
    accessible-enabled: root.enabled; accessible-checkable: true; accessible-checked: root.checked;
    accessible-action-default => { if root.enabled { root.checked = !root.checked; root.toggled(); } }
    focus := FocusScope { enabled: root.enabled; key-pressed(event) => { if event.text == " " { root.checked = !root.checked; root.toggled(); return accept; } return reject; } }
    HorizontalLayout { spacing: 9px;
        Rectangle { width: 19px; height: 19px; border-radius: 4px; border-width: 1px; border-color: focus.has-focus ? #176b83 : #aac0d0; background: root.checked ? Theme.accent : touch.has-hover ? #edf5f9 : white;
            if root.checked : Image { x: (parent.width - 12px) / 2; y: (parent.height - 12px) / 2; width: 12px; height: 12px; source: @image-url("../assets/icons/check.svg"); image-fit: contain; }
        }
        label := Text { text: root.text; color: root.enabled ? #35546a : #8b9aab; font-size: 13px; vertical-alignment: center; }
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { focus.focus(); root.checked = !root.checked; root.toggled(); } }
}

export component InfoButton inherits Rectangle {
    in property <string> label: "Backup options";
    in property <string> help;
    in property <bool> warning: false;
    width: 20px; height: 20px;
    border-radius: 10px; border-width: 1px;
    border-color: root.warning ? #d7b46c : #9bbbc9;
    background: root.warning ? #fff7e7 : touch.has-hover ? #dceff5 : #edf6f9;
    accessible-role: button; accessible-label: root.label + ". " + root.help;
    accessible-action-default => { help-popup.show(); }
    forward-focus: focus;
    focus := FocusScope { key-pressed(event) => { if event.text == Key.Return || event.text == " " { help-popup.show(); return accept; } return reject; } }
    Text { text: "i"; font-size: 12px; font-weight: 700; color: root.warning ? #976b20 : #176b83; horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); help-popup.show(); } }
    Tooltip { VerticalLayout { padding: 12px; Text { width: 360px; text: root.help; color: Theme.ink; font-size: 12px; wrap: word-wrap; } } }
    help-popup := PopupWindow {
        x: root.width - self.width; y: -self.height - 6px; width: 400px;
        Rectangle { background: white; border-radius: 8px; border-width: 1px; border-color: #b8cbd8;
            VerticalLayout { padding: 16px; spacing: 12px;
                SelectableText { text: root.label; text-color: Theme.ink; font-size: 14px; font-weight: 650; wrap: word-wrap; }
                SelectableText { text: root.help; text-color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                ActionButton { text: "Close"; clicked => { help-popup.close(); } }
            }
        }
    }
}
