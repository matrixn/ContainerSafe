import { Theme, ActionButton, ChoiceBox, ToggleCheck } from "theme.slint";
import { SelectableText } from "selectable-text.slint";
import { LineEdit, ScrollView } from "std-widgets.slint";

export component BackupDestinationSettings inherits Rectangle {
    in property <bool> default-mode: true;
    in property <bool> agent-mode: false;
    in-out property <int> kind;
    in-out property <string> location;
    in property <string> status;
    callback edited;
    min-height: root.default-mode ? 220px : 180px; vertical-stretch: 0; background: white; border-radius: 12px; border-width: 1px; border-color: Theme.line;
    VerticalLayout { padding: 20px; spacing: 10px; alignment: start;
        Text { text: root.default-mode ? @tr("Default backup destination") : @tr("Destination for this plan"); color: Theme.ink; font-size: 17px; font-weight: 700; }
        SelectableText { text: root.default-mode ? @tr("New backup plans inherit this destination. Each plan can override it. Existing plans keep their destination.") : root.agent-mode ? @tr("This destination applies only to this plan. Save the plan and update the agent configuration after changing it.") : @tr("This destination applies only to this plan. Save your changes before starting the backup."); text-color: Theme.muted; wrap: word-wrap; }
        Text { text: root.kind == 3 ? @tr("Absolute folder on this PC") : root.kind == 0 ? @tr("Absolute folder on the NAS / Docker server") : root.kind == 1 ? @tr("SFTP address of this computer") : @tr("Remote repository address: SFTP or HTTPS S3"); color: Theme.muted; font-size: 12px; }
        HorizontalLayout { spacing: 14px;
            ChoiceBox { width: 260px; model: [@tr("Folder on Docker server"), @tr("This computer (SFTP)"), @tr("Remote SFTP / S3"), @tr("This PC via SSH tunnel")]; current-index <=> root.kind; selected(value) => { root.edited(); } }
            LineEdit { text <=> root.location; placeholder-text: root.kind == 3 ? "C:/ContainerSafe" : root.kind == 0 ? "/volume1/ContainerSafe/backups" : root.kind == 1 ? "sftp:backup-pc:/C:/ContainerSafe" : "s3:https://endpoint/bucket/containersafe"; edited => { root.edited(); } }
        }
        SelectableText { text: root.kind == 3 ? @tr("The repository is stored on this PC through an authenticated loopback SSH tunnel.") : root.kind == 0 ? @tr("The folder is on the Docker server, not on this PC. Use a dedicated backup disk or share.") : root.kind == 1 ? @tr("The Docker server sends encrypted backups to this PC over SFTP. Enable an SSH/SFTP server on the PC, configure key authentication and pin its host key in the SSH account's known_hosts.") : @tr("Use SFTP with a verified host key, or S3 over HTTPS. Configure S3 credentials in the SSH account's protected AWS credentials file. Never put passwords in the URL."); text-color: Theme.muted; wrap: word-wrap; }
        SelectableText { text: root.status; text-color: Theme.accent; wrap: word-wrap; }
    }
}

export component BackupPanel inherits Rectangle {
    in-out property <bool> use-agent: false;
    in property <string> title;
    in property <string> sources;
    in-out property <int> kind;
    in-out property <string> location;
    in-out property <string> executable;
    in-out property <string> config;
    in-out property <string> job;
    in-out property <string> restic;
    in-out property <string> rest-server;
    in-out property <string> transfer-directory;
    in-out property <bool> stream;
    in-out property <string> local-restic;
    in-out property <string> local-password-file;
    in-out property <string> mirror-directory;
    in-out property <string> password-file;
    in-out property <string> restore-root;
    in-out property <bool> acknowledged;
    in-out property <[string]> snapshots;
    in-out property <int> snapshot-index;
    in property <string> result;
    in property <bool> error;
    callback action(string);
    background: white; border-radius: 12px;
    VerticalLayout { padding: 24px; spacing: 12px;
        Text { text: @tr("Manual backup") + " · " + root.title; color: Theme.ink; font-size: 20px; font-weight: 700; overflow: elide; }
        ScrollView {
            VerticalLayout { spacing: 12px;
                SelectableText { text: @tr("Approved files and selected database exports will be encrypted by Restic. Live database volumes remain excluded. MySQL/MariaDB exports block writes during the dump. Database imports are manual."); text-color: #976b20; wrap: word-wrap; }
                SelectableText { text: root.sources; text-color: Theme.muted; wrap: word-wrap; }
                BackupDestinationSettings { default-mode: false; agent-mode: root.use-agent; kind <=> root.kind; location <=> root.location; }
                if root.kind == 3 : HorizontalLayout { spacing: 12px;
                    ActionButton { text: @tr("Choose PC folder"); clicked => { root.action("browse-pc"); } }
                    ActionButton { text: @tr("Choose rest-server executable"); clicked => { root.action("browse-backend"); } }
                }
                if root.kind == 3 : LineEdit { text <=> root.rest-server; placeholder-text: "C:/Tools/rest-server.exe"; }
                if root.kind == 3 : SelectableText { text: @tr("Encrypted repository on this PC through your verified SSH connection. No SSH server is needed on the PC. The official rest-server helper runs only during this operation and listens on loopback. The PC must stay awake."); text-color: Theme.muted; wrap: word-wrap; }
                Text { text: @tr("Backup execution"); color: Theme.ink; font-size: 15px; font-weight: 650; }
                ChoiceBox { model: [@tr("Restic directly over SSH (recommended)"), @tr("ContainerSafe Linux agent (advanced)")]; current-index: root.use-agent ? 1 : 0; selected(value) => { root.use-agent = self.current-index == 1; } }
                if root.use-agent : HorizontalLayout { spacing: 12px;
                    Text { width: 150px; text: @tr("Agent executable"); color: Theme.muted; vertical-alignment: center; }
                    LineEdit { text <=> root.executable; }
                }
                if root.use-agent : HorizontalLayout { spacing: 12px;
                    Text { width: 150px; text: @tr("Agent config file"); color: Theme.muted; vertical-alignment: center; }
                    LineEdit { text <=> root.config; }
                }
                if root.use-agent : HorizontalLayout { spacing: 12px;
                    Text { width: 150px; text: @tr("Job identifier"); color: Theme.muted; vertical-alignment: center; }
                    LineEdit { text <=> root.job; read-only: true; }
                }
                HorizontalLayout { spacing: 12px;
                    Text { width: 150px; text: @tr("Restic executable"); color: Theme.muted; vertical-alignment: center; }
                    LineEdit { text <=> root.restic; }
                }
                HorizontalLayout { spacing: 12px;
                    Text { width: 150px; text: @tr("Password file on server"); color: Theme.muted; vertical-alignment: center; }
                    LineEdit { text <=> root.password-file; }
                }
                HorizontalLayout { spacing: 12px;
                    Text { width: 150px; text: @tr("Isolated restore folder"); color: Theme.muted; vertical-alignment: center; }
                    LineEdit { text <=> root.restore-root; }
                }
                SelectableText { text: root.use-agent ? @tr("First export the setup files, follow SETUP.md on the server, then initialize the repository once. Repository passwords stay on the server. The agent must be able to read the selected sources.") : @tr("No ContainerSafe agent is required. Install Restic on the NAS, create a password file with mode 600 and a separate restore folder. On DSM, Docker sudo access does not grant Restic access to files. Backup uses your SSH account without automatic sudo."); text-color: Theme.muted; wrap: word-wrap; }
                HorizontalLayout { spacing: 10px;
                    ActionButton { text: @tr("Initialize repository"); enabled: root.acknowledged; clicked => { root.action("init"); } }
                }
                HorizontalLayout { spacing: 10px;
                    ActionButton { text: @tr("List snapshots"); clicked => { root.action("snapshots"); } }
                    ActionButton { text: @tr("Check all data"); clicked => { root.action("check"); } }
                }
                if root.snapshots.length > 0 : HorizontalLayout { spacing: 10px;
                    ChoiceBox { model: root.snapshots; current-index <=> root.snapshot-index; horizontal-stretch: 1; }
                    ActionButton { text: @tr("Test restore"); enabled: root.acknowledged; clicked => { root.action("restore"); } }
                }
                if root.kind != 3 : VerticalLayout { spacing: 12px;
                    Text { text: @tr("Download an encrypted snapshot to this PC"); color: Theme.ink; font-size: 15px; font-weight: 650; }
                    SelectableText { text: @tr("First select a snapshot and create an immutable encrypted export. SFTP supports explicit resume; SSH streaming starts a new transfer on retry. Neither method requires an SSH server on the PC."); text-color: Theme.muted; wrap: word-wrap; }
                    ChoiceBox { model: [@tr("SFTP pull (resume supported)"), @tr("SSH binary streaming")]; current-index: root.stream ? 1 : 0; selected(value) => { root.stream = self.current-index == 1; } }
                    HorizontalLayout { spacing: 12px;
                        LineEdit { text <=> root.transfer-directory; placeholder-text: "C:/ContainerSafe/Downloads"; }
                        ActionButton { text: @tr("Choose PC folder"); clicked => { root.action("browse-download"); } }
                    }
                    HorizontalLayout { spacing: 12px;
                        ActionButton { text: @tr("Create encrypted export"); enabled: root.snapshots.length > 0; clicked => { root.action("export-artifact"); } }
                        ActionButton { text: @tr("Download"); clicked => { root.action("download"); } }
                        ActionButton { text: @tr("Resume SFTP"); enabled: !root.stream; clicked => { root.action("resume"); } }
                    }
                }
                Text { text: @tr("Local verification and isolated restore"); color: Theme.ink; font-size: 15px; font-weight: 650; }
                SelectableText { text: @tr("Use a local Restic executable and a protected local file containing the repository password. Secrets are never copied from the NAS. Restore creates a new directory in the chosen PC folder. Repository copy uses restic copy and preserves existing snapshots."); text-color: Theme.muted; wrap: word-wrap; }
                HorizontalLayout { spacing: 12px;
                    Text { width: 150px; text: @tr("Restic on this PC"); color: Theme.muted; vertical-alignment: center; }
                    LineEdit { text <=> root.local-restic; placeholder-text: "C:/Tools/restic.exe"; }
                }
                HorizontalLayout { spacing: 12px;
                    Text { width: 150px; text: @tr("Password file on this PC"); color: Theme.muted; vertical-alignment: center; }
                    LineEdit { text <=> root.local-password-file; placeholder-text: "C:/Private/restic.password"; }
                }
                if root.kind == 3 : HorizontalLayout { spacing: 12px;
                    LineEdit { text <=> root.transfer-directory; placeholder-text: @tr("Isolated restore folder on this PC"); }
                    ActionButton { text: @tr("Choose PC folder"); clicked => { root.action("browse-download"); } }
                }
                if root.kind != 3 : HorizontalLayout { spacing: 12px;
                    LineEdit { text <=> root.mirror-directory; placeholder-text: @tr("PC folder for repository copy"); }
                    ActionButton { text: @tr("Choose repository folder"); clicked => { root.action("browse-mirror"); } }
                    ActionButton { text: @tr("Copy into PC repository"); enabled: root.acknowledged; clicked => { root.action("mirror"); } }
                }
                HorizontalLayout { spacing: 10px;
                    ActionButton { text: @tr("Verify on PC"); clicked => { root.action("verify-local"); } }
                    ActionButton { text: @tr("Test restore on PC"); enabled: root.acknowledged; clicked => { root.action("restore-local"); } }
                    ActionButton { text: @tr("Open PC folder"); clicked => { root.action("open-folder"); } }
                    ActionButton { text: @tr("Transfer history"); clicked => { root.action("transfer-history"); } }
                }
                SelectableText { text: root.result; selectable: root.error; text-color: root.error ? #a34431 : Theme.accent; wrap: word-wrap; }
            }
        }
        ToggleCheck { text: @tr("I accept a file-level backup; application consistency and full recovery are not guaranteed."); checked <=> root.acknowledged; }
        HorizontalLayout { spacing: 12px;
            ActionButton { text: @tr("Save plan"); clicked => { root.action("save"); } }
            ActionButton { text: @tr("Export setup"); clicked => { root.action("export"); } }
            Rectangle { horizontal-stretch: 1; }
            ActionButton { text: @tr("Back up now"); primary: true; enabled: root.acknowledged; clicked => { root.action("backup"); } }
            ActionButton { text: @tr("Close"); clicked => { root.action("close"); } }
        }
    }
}
