msgstr "Salvează modificările înainte de validare"

msgid "Validating selection with existing Rust CLI..."
msgstr "Se validează selecția cu instrumentul Rust existent..."

msgid "Selection valid · no backup authorized"
msgstr "Selecție validă · niciun backup autorizat"

msgid "Needs review"
msgstr "Necesită verificare"

msgid "Last success"
msgstr "Ultimul succes"

msgid "SSH port must be between 1 and 65535"
msgstr "Portul SSH trebuie să fie între 1 și 65535"

msgid "Timeout must be 1-120 seconds"
msgstr "Timpul de așteptare trebuie să fie între 1 și 120 de secunde"

msgid "Password required"
msgstr "Parola este obligatorie"

msgid "Cannot build plan"
msgstr "Planul nu poate fi construit"

msgid "Cannot read plan"
msgstr "Planul nu poate fi citit"

msgid "Workspace state unavailable"
msgstr "Starea spațiului de lucru nu este disponibilă"

