msgstr "Limbă"

msgid "Choose the interface language. Changes apply immediately."
msgstr "Alege limba interfeței. Modificarea se aplică imediat."

msgid "Start page"
msgstr "Pagina de pornire"

msgid "Choose the workspace shown when ContainerSafe starts."
msgstr "Alege pagina afișată la pornirea ContainerSafe."

msgid "Initial source filter"
msgstr "Filtrul inițial al surselor"

msgid "Start with all sources, storage only, or databases only. You can change the filter in Containers."
msgstr "Pornește cu toate sursele, doar stocare sau doar baze de date. Poți schimba filtrul în Containere."

msgid "Default SSH port"
msgstr "Portul SSH implicit"

msgid "Used when adding a new server. Existing profiles keep their own port."
msgstr "Folosit la adăugarea unui server. Profilurile existente își păstrează portul."

msgid "Default connection timeout"
msgstr "Timpul de așteptare implicit"

msgid "Maximum wait for SSH network operations on new profiles. Existing profiles are unchanged."
msgstr "Timpul maxim pentru operațiile de rețea SSH ale profilurilor noi. Profilurile existente nu se modifică."

