msgid "Choose a container or stack to review its storage."
msgstr "Alege un container sau grup pentru a analiza stocarea."

msgid "No persistent storage or database detected for this selection."
msgstr "Nu s-a detectat stocare persistentă sau bază de date pentru această selecție."

msgid "Selections prepare a backup plan. Production backup execution is not enabled."
msgstr "Selecțiile pregătesc un plan de backup. Execuția backupurilor de producție nu este activată."

msgid "Selected operations"
msgstr "Operații selectate"

msgid "No backup selected"
msgstr "Fără backup selectat"

