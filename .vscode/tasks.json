{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run ContainerSafe desktop",
      "type": "process",
      "command": "cargo",
      "windows": { "command": "${env:USERPROFILE}\\.cargo\\bin\\cargo.exe" },
      "args": ["run", "--locked", "--manifest-path", "native/Cargo.toml"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$rustc"],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Build ContainerSafe desktop",
      "type": "process",
      "command": "cargo",
      "windows": { "command": "${env:USERPROFILE}\\.cargo\\bin\\cargo.exe" },
      "args": ["build", "--locked", "--manifest-path", "native/Cargo.toml"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$rustc"],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
